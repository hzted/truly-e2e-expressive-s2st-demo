{
  "release_scope": "VC-DUB construction procedure; no audio or full source-corpus manifests are redistributed in the GitHub mirror.",
  "pipeline_order": [
    "aligned_speech_segments",
    "clearvoice_denoising",
    "demucs_vocal_extraction",
    "mms_lid_filtering",
    "sortformer_single_speaker_filtering",
    "dnsmospro_quality_selection",
    "whisper_large_v3_text_metadata",
    "train_dev_test_split",
    "local_voice_conversion_materialization"
  ],
  "preprocessing": {
    "denoising": {
      "tool": "ClearVoice-Studio",
      "model": "MossFormer2_SE_48K",
      "inference_settings": "default"
    },
    "vocal_extraction": {
      "tool": "Demucs",
      "model": "htdemucs",
      "inference_settings": "default"
    }
  },
  "filtering": {
    "mms_lid": {
      "model": "facebook/mms-lid-126",
      "criterion": "top-1 predicted labels must match expected source and target languages",
      "confidence_threshold": null
    },
    "sortformer": {
      "model": "nvidia/diar_sortformer_4spk-v1",
      "criterion": "source and target each have <= 1 detected active speaker",
      "audio_preprocessing": "16 kHz mono before diarization"
    },
    "quality_selection": {
      "model": "DNSMOSPro",
      "score_columns": [
        "src_dnsmospro",
        "tgt_dnsmospro",
        "combined_dnsmospro"
      ],
      "combined_score": "source-target combined DNSMOSPro quality score",
      "silence_removal": true,
      "language_pair_settings": {
        "en_es": {
          "expected_source_lid": "eng",
          "expected_target_lid": "spa",
          "target_keep_pairs": 90000,
          "empirical_retained_dropped_boundary": 3.57
        },
        "en_de": {
          "expected_source_lid": "eng",
          "expected_target_lid": "deu",
          "target_keep_pairs": 147639,
          "empirical_retained_dropped_boundary": 3.60
        }
      }
    }
  },
  "text_metadata": {
    "asr_model": "openai/whisper-large-v3",
    "purpose": "populate text-bearing *_asr.tsv split manifests used by downstream evaluation and VC materialization"
  },
  "splits": {
    "test_size_pairs": 500,
    "dev_test_fraction_before_fixed_test": 0.15,
    "seed": 42
  },
  "voice_conversion": {
    "position": "final local materialization step after filtering and splitting",
    "input_manifest": "*_asr.tsv with id/pre_src/pre_tgt columns",
    "redistribution_policy": "generated VC waveforms are not redistributed"
  },
  "observed_stage_counts": {
    "en_es": {
      "raw_pairs": 352947,
      "after_mms_lid": 213469,
      "after_sortformer_single_speaker": 164746,
      "after_dnsmospro_quality_selection": 90000,
      "train_pairs": 79200
    },
    "en_de": {
      "raw_pairs": 369139,
      "after_mms_lid": 298929,
      "after_sortformer_single_speaker": 237743,
      "after_dnsmospro_quality_selection": 147639,
      "train_pairs": 131399
    }
  }
}
